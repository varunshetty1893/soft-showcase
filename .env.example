# =============================================================================
# SOFT SHOWCASE — ENVIRONMENT VARIABLES EXAMPLE
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file containing real credentials.
# See docs/33-environment-variables.md for full documentation.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Neon recommended for production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Direct connection (used by Prisma migrations — bypasses connection pooling)
DIRECT_URL=


# -----------------------------------------------------------------------------
# NEXTAUTH / AUTHENTICATION
# -----------------------------------------------------------------------------
# A long random secret used to sign session tokens
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-very-long-random-secret-here

# The canonical URL of your application (no trailing slash)
NEXTAUTH_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# GOOGLE OAUTH
# -----------------------------------------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# -----------------------------------------------------------------------------
# EMAIL (Gmail SMTP)
# -----------------------------------------------------------------------------
# Official email provider: "gmail"
EMAIL_PROVIDER=gmail

# Gmail direct SMTP configuration (Port 465 with SSL/TLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=my-gmail-address
SMTP_PASSWORD=my-google-app-password

# The "From" address and display name for outgoing emails
EMAIL_FROM=my-gmail-address
EMAIL_FROM_NAME=Soft Showcase

# Platform admin email — receives custom project requests and system alerts
ADMIN_EMAIL=admin@yourdomain.com


# -----------------------------------------------------------------------------
# IMAGE / FILE STORAGE
# -----------------------------------------------------------------------------
# Which storage provider to use: "cloudinary" | "uploadthing"
STORAGE_PROVIDER=cloudinary

# Cloudinary credentials (if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Uploadthing credentials (if STORAGE_PROVIDER=uploadthing)
UPLOADTHING_SECRET=your-uploadthing-secret
UPLOADTHING_APP_ID=your-uploadthing-app-id


# NOTE: There is NO DEFAULT_WHATSAPP_NUMBER variable.
# WhatsApp routing is always project-specific: project → provider → whatsappNumber
# If a provider has no WhatsApp number, the WhatsApp button is hidden.
# No fallback number exists. See docs/04-provider-model.md.


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# The public URL of the application (used for SEO, sitemap, OpenGraph)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application name displayed in UI
NEXT_PUBLIC_APP_NAME=Soft Showcase


# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Use "memory" for local dev; configure upstash for production (optional)
RATE_LIMIT_PROVIDER=memory

# Upstash Redis (optional — only needed if RATE_LIMIT_PROVIDER=upstash)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
